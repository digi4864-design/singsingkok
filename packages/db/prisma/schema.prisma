generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPING
  DELIVERED
  RETURN_REQUESTED
  CANCELED
}

enum PaymentStatus {
  READY
  DONE
  CANCELED
  FAILED
}

enum ShipmentStatus {
  READY
  REGISTERED
  IN_TRANSIT
  DELIVERED
}

enum Role {
  CUSTOMER
  ADMIN
}

// 누적 구매금액 기준 회원등급. 새싹(기본) -> 잎새 -> 열매 -> 황금열매(VIP) 순.
// 정확한 기준 금액은 apps/web/src/lib/membership.ts에서 관리한다.
enum MembershipTier {
  SPROUT
  LEAF
  FRUIT
  GOLD
}

// 포인트 적립/사용 내역. 지급 시점(가입/추천)과 사용 시점(결제확정)이 다르므로
// User.points 잔액과 별개로 감사(audit) 목적의 원장을 남긴다.
enum PointTransactionType {
  REFERRAL_BONUS         // 내가 추천한 친구가 가입해서 받은 적립
  REFERRED_SIGNUP_BONUS  // 추천을 받아 가입해서 받은 적립
  ORDER_REDEMPTION       // 결제 시 포인트 사용(차감)
  ORDER_REFUND           // 결제 확정 후 주문이 취소되어 사용한 포인트 환급
  REVIEW_REWARD          // 리뷰 작성 보상
}

// 쇼핑몰 전역 설정(입금계좌 안내, 사업자정보 등). 항상 id="default" 단일 행만 사용한다.
model StoreSetting {
  id                     String   @id @default("default")
  bankName               String?
  bankAccountNumber      String?
  bankAccountHolder      String?
  contactPhone           String?
  businessName           String? // 상호명
  representativeName     String? // 대표자명
  businessRegistrationNo String? // 사업자등록번호
  mailOrderSalesNo       String? // 통신판매업 신고번호
  businessAddress        String?
  promoBannerEnabled     Boolean  @default(false) // 메인페이지 상단 홍보 배너 노출 여부
  promoBannerText        String?  // 배너에 노출할 홍보 문구
  promoBannerLink        String?  // 배너 클릭 시 이동할 경로(예: /signup). 비어있으면 클릭 불가
  cardFeePercent         Float    @default(3.2) // 카드결제 PG 수수료율(%) - 마진 계산 시 카드 결제 주문에서만 차감
  updatedAt              DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// 공급가 구간별 마진율 규칙. 예: 5,000~10,000원 구간은 +20%, 10,000~20,000원 구간은 +15%.
// maxPrice가 null이면 "minPrice 이상" 전체에 적용되는 최상위 구간을 의미한다.
model MarginBracket {
  id            String   @id @default(cuid())
  minPrice      Int
  maxPrice      Int?
  marginPercent Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id               String   @id @default(cuid())
  name             String   @unique // 파트너몰 원본 상품명 - 매일 자동 동기화/구글드라이브 이미지 매칭의 기준 키이므로 변경 금지
  displayName      String?  // 쇼핑몰에 노출할 상품명(관리자가 수정 가능). 없으면 name을 그대로 노출
  thumbnailUrl     String? // thumbnailImages[0]과 항상 동일하게 유지(카드/장바구니 등 대표이미지로 쓰임)
  thumbnailImages  String[] // 상품 상세페이지 상단 갤러리 (최대 5장)
  // 자동 동기화가 썸네일을 가져온 출처(구글드라이브 폴더명 또는 "choigozip:상품명").
  // 서로 다른 상품이 같은 값을 가지면 같은 사진을 공유하고 있다는 뜻이라 관리자 화면에서
  // 점검 목록으로 보여준다. 관리자가 수동으로 사진을 올리면 null로 비워 점검 대상에서 뺀다.
  thumbnailSourceKey String?
  images           String[]
  description      String?  // 최고집 공개 API에서 매일 자동으로 가져오는 상품 상세설명(HTML)
  supplierNotice   String?  // 최고집 공급사 공지사항(시즌/품질 안내 등) - 매일 자동 갱신
  origin           String?  // 원산지 (농수산물의 원산지 표시에 관한 법률에 따라 표시 필요)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false) // 관리자가 지정하는 "제철 베스트 상품" - 메인 화면 상단 노출
  instagramPostedAt DateTime? // 인스타그램에 게시한 시각(중복 게시 방지용). null이면 아직 게시 안 함
  category         Category? @relation(fields: [categoryId], references: [id])
  categoryId       String?
  options          ProductOption[]
  wishlistedBy     Wishlist[]
  reviews          Review[]
  restockSubscribers RestockSubscription[]
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 구매자 상품평. 최초 버전은 실구매 검증 없이 로그인 회원이 상품당 1개까지 작성 가능(위시리스트와 동일 패턴).
model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int      // 1~5
  content   String
  images    String[] @default([]) // 리뷰 사진(최대 3장)
  isHidden  Boolean  @default(false) // 관리자 숨김 처리(부적절한 내용 등)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

// 품절 상품의 "재입고 알림 신청". 재입고(옵션이 다시 판매중으로 바뀜) 시 웹 푸시로 알린다.
model RestockSubscription {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, productId])
}

// 최고집 상품 엑셀은 상품 1개당 무게/등급별 옵션이 여러 행으로 제공됨
// (예: "자색양파" - "5kg/중", "5kg/대", "10kg/소" ...). 옵션별로 관리코드·가격·판매상태가 다르다.
model ProductOption {
  id              String      @id @default(cuid())
  product         Product     @relation(fields: [productId], references: [id])
  productId       String
  sourceOptionId  String      @unique // 최고집 관리코드
  optionName      String              // 옵션명 (예: "1kg / 대과 / 1~2번과")
  price           Int                 // 공급가 (원가, 고객에게 노출되지 않음)
  sellingPrice    Int                 // 실제 판매가 (고객에게 노출·결제되는 금액)
  isPriceManual   Boolean     @default(false) // true면 재업로드 시 판매가를 자동 재계산하지 않고 유지
  compliancePrice Int?                // 준수판매가 (공급사가 지정한 최소 판매가, 있는 경우)
  isAvailable     Boolean     @default(true) // 판매상태 == "판매중"
  supplierCourier String?             // 택배사
  outboundType    String?             // 출고지 (위탁/센터)
  orderCutoff     String?             // 발주마감시간
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Auth.js(NextAuth) PrismaAdapter가 요구하는 표준 스키마(User/Account/Session/VerificationToken).
// passwordHash/phone/zipCode/address/addressDetail은 이메일 회원가입(Credentials 로그인) 및
// 체크아웃 배송지 자동입력을 위해 추가한 필드.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  zipCode       String?
  address       String?
  addressDetail String?
  role          Role      @default(CUSTOMER)
  totalSpent    Int       @default(0) // 누적 구매금액 (취소된 주문 제외) - 결제 확정 시마다 갱신
  membershipTier MembershipTier @default(SPROUT)
  hasWelcomeCoupon   Boolean @default(false) // 신규가입 축하 5% 할인 쿠폰 보유 여부 (가입 시 즉시 발급)
  welcomeCouponUsed  Boolean @default(false)
  hasFirstPurchaseCoupon   Boolean @default(false) // 첫구매 완료 감사 5,000원 쿠폰 (첫 결제 확정 시 발급, 다음 구매부터 사용 가능)
  firstPurchaseCouponUsed  Boolean @default(false)
  points        Int       @default(0) // 사용 가능한 포인트 잔액 (결제 시 1점=1원으로 사용 가능)
  referredById  String?   // 나를 추천해서 가입시킨 회원 (가입 시 1회만 설정, 이후 변경 불가)
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")
  pointTransactions PointTransaction[]
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  wishlist      Wishlist[]
  reviews       Review[]
  addresses     Address[]
  pushSubscriptions PushSubscription[]
  restockSubscriptions RestockSubscription[]
  cartActivity  CartActivity?
  createdAt     DateTime  @default(now())
}

// 장바구니 자체는 여전히 브라우저(localStorage)에만 저장된다(결제 흐름을 건드리지 않기 위함).
// 이 모델은 로그인 회원이 장바구니를 담아두고 방치했을 때 리마인드 푸시를 보내기 위한
// 가벼운 스냅샷일 뿐이다 - 실제 재고/가격의 원천이 아니므로 상품과 관계를 맺지 않고
// 문구 생성에 필요한 최소 정보만 JSON으로 들고 있는다.
model CartActivity {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @unique
  itemsJson  Json      // [{ productId, name, quantity }] 스냅샷 - 리마인드 문구 생성용
  remindedAt DateTime? // 리마인드 발송 시각(중복 발송 방지). 장바구니가 바뀌면 다시 null로 초기화됨
  updatedAt  DateTime  @updatedAt
}

// 관리자 기기의 웹 푸시 구독 정보. 신규가입/신규주문 발생 시 여기 등록된 기기로 알림을 보낸다.
// 한 관리자가 여러 기기(폰/PC)에서 구독하면 기기마다 별도 행이 생긴다.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// 포인트 적립/사용 원장. User.points 잔액 변동이 있을 때마다 기록해서 내역 조회·감사에 사용한다.
model PointTransaction {
  id        String               @id @default(cuid())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  amount    Int                  // 양수=적립, 음수=사용/차감
  type      PointTransactionType
  order     Order?               @relation(fields: [orderId], references: [id])
  orderId   String?
  createdAt DateTime             @default(now())

  @@index([userId])
}

// 마이페이지에서 관리하는 배송지록 - 체크아웃 시 여러 배송지 중 선택하거나 새 배송지를 저장할 수 있다.
model Address {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  label          String? // 별칭 (예: "집", "회사")
  recipientName  String
  recipientPhone String
  zipCode        String
  address        String
  addressDetail  String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id              String      @id @default(cuid())
  orderNo         String      @unique
  customer        User?       @relation(fields: [customerId], references: [id])
  customerId      String?
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Int         @default(0) // 할인 적용 전 상품 금액 합계
  discountAmount  Int         @default(0) // 등급 할인 + 쿠폰 할인 합계 (원)
  couponApplied   Boolean     @default(false) // 신규가입 축하 5% 쿠폰 사용 여부
  firstPurchaseCouponApplied Boolean @default(false) // 첫구매 감사 5,000원 쿠폰 사용 여부
  pointsUsed      Int         @default(0) // 결제 시 사용한 포인트(원). totalAmount에는 이미 차감 반영됨
  totalAmount     Int
  recipientName   String
  recipientPhone  String
  zipCode         String
  address         String
  addressDetail   String?
  memo            String?
  returnReason    String? // 고객이 반품 요청 시 입력한 사유
  reviewReminderSentAt DateTime? // 배송완료 후 리뷰 작성 리마인드 푸시를 보낸 시각(중복 발송 방지)
  items           OrderItem[]
  payment         Payment?
  pointTransactions PointTransaction[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// 한 주문에 상품이 여러 개면 공급사가 상품별로 따로 출고해 운송장번호가 각각 다르게
// 나온다(같은 사람이 시킨 주문이어도 택배가 여러 개로 나뉨). 그래서 배송(Shipment)은
// 주문이 아니라 주문상품(OrderItem) 단위로 붙는다.
model OrderItem {
  id              String        @id @default(cuid())
  order           Order         @relation(fields: [orderId], references: [id])
  orderId         String
  productOption   ProductOption @relation(fields: [productOptionId], references: [id])
  productOptionId String
  productName     String
  optionName      String
  unitPrice       Int
  unitCost        Int      @default(0) // 주문 시점 공급가(원가) 스냅샷 - 마진 계산용
  quantity        Int
  lineTotal       Int
  lineNo          Int      @default(1) // 주문 내 순번(1부터). 발주 엑셀의 "거래처주문번호-N" 접미사와 매칭되는 값
  shipment        Shipment?
}

model Payment {
  id          String        @id @default(cuid())
  order       Order         @relation(fields: [orderId], references: [id])
  orderId     String        @unique
  paymentKey  String?       @unique
  method      String?
  amount      Int
  status      PaymentStatus @default(READY)
  approvedAt  DateTime?
  rawResponse Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Shipment {
  id                 String         @id @default(cuid())
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id])
  orderItemId        String         @unique
  courier            String?
  trackingNumber     String?
  status             ShipmentStatus @default(READY)
  invoiceRegisteredAt DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ImportRun {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  totalProducts   Int       @default(0)
  totalOptions    Int       @default(0)
  createdProducts Int       @default(0)
  updatedProducts Int       @default(0)
  imageSynced     Int       @default(0)
  imageSkipped    Int       @default(0)
  imageFailed     Int       @default(0)
  errorLog        String?
}
